rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOwnerKey(ownerId) {
      return ownerId is string &&
        ownerId.size() >= 3 &&
        ownerId.size() <= 128 &&
        ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        (
          (request.auth != null && ownerId == request.auth.uid) ||
          ownerId.matches('^sync_[a-zA-Z0-9_\\-]{2,120}$')
        );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLessonMeta(data) {
      return data.keys().hasAll([
        'id',
        'ownerId',
        'title',
        'className',
        'customCode',
        'slideCount',
        'chunkCount',
        'updatedAtMs',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerId',
        'title',
        'className',
        'customCode',
        'slideCount',
        'chunkCount',
        'updatedAtMs',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidOwnerKey(data.ownerId) &&
      data.title is string && data.title.size() <= 500 &&
      data.className is string && data.className.size() <= 200 &&
      data.customCode is string && data.customCode.size() <= 32 &&
      data.slideCount is int && data.slideCount >= 0 && data.slideCount <= 2000 &&
      data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 200 &&
      data.updatedAtMs is int && data.updatedAtMs >= 0 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLessonChunk(data) {
      return data.keys().hasAll([
        'ownerId',
        'lessonId',
        'idx',
        'data',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'lessonId',
        'idx',
        'data',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidOwnerKey(data.ownerId) &&
      isValidId(data.lessonId) &&
      data.idx is int && data.idx >= 0 && data.idx <= 200 &&
      data.data is string && data.data.size() >= 1 && data.data.size() <= 750000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSessionReportDoc(data) {
      return data.keys().hasAll([
        'id',
        'ownerId',
        'lessonTitle',
        'className',
        'roomCode',
        'updatedAtMs',
        'payloadJson',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerId',
        'lessonTitle',
        'className',
        'roomCode',
        'updatedAtMs',
        'payloadJson',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidOwnerKey(data.ownerId) &&
      data.lessonTitle is string && data.lessonTitle.size() <= 500 &&
      data.className is string && data.className.size() <= 200 &&
      data.roomCode is string && data.roomCode.size() <= 32 &&
      data.updatedAtMs is int && data.updatedAtMs >= 0 &&
      data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 850000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /lessons/{lessonId} {
      allow get: if isValidId(lessonId) && (resource == null || isValidOwnerKey(resource.data.ownerId));
      allow list: if true;

      allow create: if isValidId(lessonId) &&
        isValidLessonMeta(incoming()) &&
        incoming().id == lessonId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(lessonId) &&
        isValidLessonMeta(incoming()) &&
        resource != null &&
        isValidOwnerKey(resource.data.ownerId) &&
        incoming().ownerId == resource.data.ownerId &&
        incoming().id == resource.data.id &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(lessonId) && (resource == null || isValidOwnerKey(resource.data.ownerId));

      match /chunks/{chunkId} {
        allow get: if isValidId(lessonId) && isValidId(chunkId) && (resource == null || isValidOwnerKey(resource.data.ownerId));
        allow list: if true;

        allow create: if isValidId(lessonId) &&
          isValidId(chunkId) &&
          isValidLessonChunk(incoming()) &&
          incoming().lessonId == lessonId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isValidId(lessonId) &&
          isValidId(chunkId) &&
          isValidLessonChunk(incoming()) &&
          resource != null &&
          isValidOwnerKey(resource.data.ownerId) &&
          incoming().ownerId == resource.data.ownerId &&
          incoming().lessonId == resource.data.lessonId &&
          incoming().createdAt == resource.data.createdAt &&
          incoming().updatedAt == request.time;

        allow delete: if isValidId(lessonId) && isValidId(chunkId) && (resource == null || isValidOwnerKey(resource.data.ownerId));
      }
    }

    match /reports/{reportId} {
      allow get: if isValidId(reportId) && (resource == null || isValidOwnerKey(resource.data.ownerId));
      allow list: if true;

      allow create: if isValidId(reportId) &&
        isValidSessionReportDoc(incoming()) &&
        incoming().id == reportId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(reportId) &&
        isValidSessionReportDoc(incoming()) &&
        resource != null &&
        isValidOwnerKey(resource.data.ownerId) &&
        incoming().ownerId == resource.data.ownerId &&
        incoming().id == resource.data.id &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isValidId(reportId) && (resource == null || isValidOwnerKey(resource.data.ownerId));
    }
  }
}
